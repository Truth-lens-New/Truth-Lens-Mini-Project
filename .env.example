# Database Configuration
POSTGRES_USER=truthlens
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=truthlens
DATABASE_URL=postgresql+asyncpg://truthlens:your_secure_password_here@localhost:5432/truthlens

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_FACTCHECK_API_KEY= your_google_factcheck_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# Backend Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Deployment environment: "development" (default) or "production".
# In production the backend REFUSES to start with the sample JWT secret or
# default database credentials (see backend/app/core/startup_checks.py).
ENVIRONMENT=development

# Optional LLM crux extraction with Gemini for long documents (extra cost,
# per-request latency). Keep OFF to use the local spaCy crux ranking.
USE_LLM_CRUX=false
GEMINI_MODEL=gemini-2.5-flash

# Investigation guardrails
MAX_CONCURRENT_INVESTIGATIONS=2
MAX_INVESTIGATION_RATE=10
RATE_WINDOW_SECONDS=60
MAX_CLAIMS_PER_INVESTIGATION=5
