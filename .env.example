# Database Configuration
POSTGRES_USER=truthlens
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=truthlens
DATABASE_URL=postgresql+asyncpg://truthlens:your_secure_password_here@localhost:5432/truthlens

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_FACTCHECK_API_KEY= your_google_factcheck_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# Optional: self-hosted Firecrawl evidence retrieval. Do not include /v2 in the URL.
FIRECRAWL_URL=https://firecrawl.mycilo.app
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_SECONDS=20
FIRECRAWL_MAX_RESULTS=5

# Docker resource caps (increase only if a model fails to load)
POSTGRES_MEMORY_LIMIT=512m
BACKEND_MEMORY_LIMIT=3g
CLIENT_MEMORY_LIMIT=768m

# Backend Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
